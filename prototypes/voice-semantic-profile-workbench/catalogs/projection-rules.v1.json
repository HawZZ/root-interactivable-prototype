{
  "catalog": "ProjectionRuleCatalog",
  "version": "2026.08.3",
  "rules": [
    { "ruleId": "alexa.device.power.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "device.power", "slot": "value" }], "outputs": [{ "capabilityId": "PowerController", "adapterTemplate": "direct_property" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home PowerController" },
    { "ruleId": "google.device.power.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "device.power", "slot": "value" }], "outputs": [{ "capabilityId": "OnOff", "adapterTemplate": "google_onoff" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "1:1", "source": "Google Home OnOff trait" },
    { "ruleId": "alexa.light.brightness.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "light.brightness", "slot": "value" }], "outputs": [{ "capabilityId": "BrightnessController", "adapterTemplate": "direct_property" }], "conditions": { "sourceTypes": ["int", "float", "double"] }, "priority": 100, "catalogOrder": 10, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home BrightnessController" },
    { "ruleId": "google.light.brightness.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "light.brightness", "slot": "value" }], "outputs": [{ "capabilityId": "Brightness", "adapterTemplate": "google_brightness" }], "conditions": { "sourceTypes": ["int", "float", "double"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "1:1", "source": "Google Home Brightness trait" },
    { "ruleId": "alexa.light.color.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "light.color", "slot": "color" }], "outputs": [{ "capabilityId": "ColorController", "adapterTemplate": "structured_hsb" }], "conditions": { "sourceTypes": ["string"], "valueShapes": ["color_hsb", "color_rgb"] }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home ColorController" },
    { "ruleId": "alexa.light.color-composite.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "light.color_control", "slot": "payload" }], "outputs": [{ "capabilityId": "ColorController", "adapterTemplate": "structured_hsb" }, { "capabilityId": "ColorTemperatureController", "adapterTemplate": "structured_cct" }], "conditions": { "sourceTypes": ["string"], "valueShapes": ["color_hsb_cct"] }, "priority": 100, "support": "conditional", "lifecycle": "draft", "relation": "1:N", "source": "Alexa color interfaces" },
    { "ruleId": "google.light.color-aggregate.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "light.color", "slot": "color" }, { "semanticId": "light.color_temperature", "slot": "temperature" }], "outputs": [{ "capabilityId": "ColorSetting", "adapterTemplate": "google_color_setting" }], "conditions": { "requiresAllInputs": true }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "N:1", "source": "Google Home ColorSetting trait" },
    { "ruleId": "alexa.device.mode.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "device.mode", "slot": "value" }], "outputs": [{ "capabilityId": "ModeController", "adapterTemplate": "direct_property" }], "conditions": { "sourceTypes": ["enum"] }, "valueTransformPolicy": { "mode": "generated" }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "结构转换", "source": "Alexa Smart Home ModeController" },
    { "ruleId": "google.device.mode.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "device.mode", "slot": "value" }], "outputs": [{ "capabilityId": "Modes", "adapterTemplate": "google_modes" }], "conditions": { "sourceTypes": ["enum"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "结构转换", "source": "Google Home Modes trait" },
    { "ruleId": "alexa.device.numeric-range.v2", "version": 2, "provider": "alexa", "semanticInputs": [{ "semanticId": "device.numeric_range", "slot": "value" }], "outputs": [{ "capabilityId": "RangeController", "adapterTemplate": "source_range" }], "conditions": { "sourceTypes": ["int", "float", "double", "enum"] }, "valueTransformPolicy": { "mode": "direct" }, "priority": 100, "catalogOrder": 20, "support": "ready", "lifecycle": "published", "relation": "条件投影", "source": "Alexa Smart Home RangeController" },
    { "ruleId": "google.device.numeric-range.unsupported.v2", "version": 2, "provider": "google_home", "semanticInputs": [{ "semanticId": "device.numeric_range", "slot": "value" }], "outputs": [], "conditions": { "reason": "Google 不存在通用范围 Trait，必须按具体设备语义另建规则。" }, "priority": 100, "support": "unsupported", "lifecycle": "published", "relation": "unsupported", "source": "Google Home trait model" },
    { "ruleId": "alexa.device.toggle.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "device.toggle", "slot": "value" }], "outputs": [{ "capabilityId": "ToggleController", "adapterTemplate": "direct_property" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "结构转换", "source": "Alexa Smart Home ToggleController" },
    { "ruleId": "google.device.toggle.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "device.toggle", "slot": "value" }], "outputs": [{ "capabilityId": "Toggles", "adapterTemplate": "google_toggles" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "结构转换", "source": "Google Home Toggles trait" },
    { "ruleId": "alexa.audio.volume.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "audio.volume", "slot": "value" }], "outputs": [{ "capabilityId": "Speaker", "adapterTemplate": "speaker_volume" }], "conditions": { "sourceTypes": ["int", "float", "double"] }, "priority": 100, "catalogOrder": 30, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home Speaker" },
    { "ruleId": "google.audio.volume.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "audio.volume", "slot": "value" }], "outputs": [{ "capabilityId": "Volume", "adapterTemplate": "google_volume" }], "conditions": { "sourceTypes": ["int", "float", "double"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "1:1", "source": "Google Home Volume trait" },
    { "ruleId": "alexa.audio.playback-control.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "audio.playback_control", "slot": "command" }], "outputs": [{ "capabilityId": "PlaybackController", "adapterTemplate": "playback_operations" }], "conditions": { "sourceKinds": ["command"] }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home PlaybackController" },
    { "ruleId": "google.audio.playback-control.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "audio.playback_control", "slot": "command" }], "outputs": [{ "capabilityId": "TransportControl", "adapterTemplate": "google_transport" }], "conditions": { "sourceKinds": ["command"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "1:1", "source": "Google Home TransportControl trait" },
    { "ruleId": "alexa.audio.playback-state.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "audio.playback_state", "slot": "state" }], "outputs": [{ "capabilityId": "PlaybackStateReporter", "adapterTemplate": "playback_state" }], "conditions": { "sourceTypes": ["enum"] }, "valueTransformPolicy": { "mode": "required", "semanticToProvider": [{ "semanticValue": "PLAYING", "providerValue": "PLAYING" }, { "semanticValue": "PAUSED", "providerValue": "PAUSED" }, { "semanticValue": "STOPPED", "providerValue": "STOPPED" }], "requireSourceCoverage": true, "requireTargetUniqueness": true, "requireTargetCoverage": false }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "1:1", "source": "Alexa Smart Home PlaybackStateReporter" },
    { "ruleId": "alexa.device.connectivity.v1", "version": 1, "provider": "alexa", "productConfigurable": false, "semanticInputs": [{ "semanticId": "device.connectivity", "slot": "state" }], "outputs": [{ "capabilityId": "EndpointHealth", "adapterTemplate": "endpoint_health" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "ready", "lifecycle": "published", "relation": "协议状态", "source": "Alexa Smart Home EndpointHealth" },
    { "ruleId": "google.device.connectivity.v1", "version": 1, "provider": "google_home", "semanticInputs": [{ "semanticId": "device.connectivity", "slot": "state" }], "outputs": [{ "capabilityId": "online", "adapterTemplate": "google_sync_query_online" }], "conditions": { "sourceTypes": ["bool"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "协议字段", "source": "Google Home SYNC/QUERY online field" },
    { "ruleId": "alexa.sensor.temperature.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "sensor.temperature", "slot": "value" }], "outputs": [{ "capabilityId": "TemperatureSensor", "adapterTemplate": "temperature_sensor" }], "conditions": { "sourceTypes": ["int", "float", "double"] }, "priority": 100, "support": "metadata_only", "lifecycle": "draft", "relation": "1:1", "source": "Alexa Smart Home TemperatureSensor" },
    { "ruleId": "alexa.device.label.unsupported.v1", "version": 1, "provider": "alexa", "semanticInputs": [{ "semanticId": "device.label", "slot": "value" }], "outputs": [], "conditions": { "reason": "Alexa Smart Home 没有通用文本属性接口。" }, "priority": 100, "support": "unsupported", "lifecycle": "published", "relation": "unsupported", "source": "Alexa Smart Home interface model" }
  ]
}
